{
  "name": "core-research-explorer-angular",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "dev": "tsx server/server.ts",
    "dev:ng": "ng serve --port 4200 --proxy-config proxy.conf.json",
    "start": "tsx server/server.ts",
    "build": "ng build",
    "build:dev": "ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "clean": "rm -rf dist .angular"
  },
  "dependencies": {
    "@angular/cdk": "~20.2.14",
    "@angular/common": "~20.3.35",
    "@angular/compiler": "~20.3.35",
    "@angular/core": "~20.3.35",
    "@angular/forms": "~20.3.35",
    "@angular/platform-browser": "~20.3.35",
    "@angular/router": "~20.3.35",
    "chart.js": "^4.5.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~20.3.35",
    "@angular/cli": "~20.3.35",
    "@angular/compiler-cli": "~20.3.35",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
